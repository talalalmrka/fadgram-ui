{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@icons/*": ["./icons/*"],
      "@js/*": ["./src/js/*"],
      "@css/*": ["./src/css/*"],
      "@gen/*": ["./docs/.vitepress/gen/*"],
      "@components/*": ["./docs/.vitepress/theme/components/*"],
      "@layout/*": ["./docs/.vitepress/theme/layout/*"],
      "@md/*": ["./docs/.vitepress/theme/markdown/*"],
      "@src/*": ["./src/*"],
      "@composables/*": ["./docs/.vitepress/theme/composables/*"],
      "@docs/*": ["./docs/*"]
    }
  },
  "include": [
    "docs/.vitepress/**/*.ts",
    "docs/.vitepress/**/*.vue",
    "docs/.vitepress/**/*.d.ts"
  ]
}
